# /etc/systemd/system/streetsense.service
[Unit]
Description=StreetSense web app
After=network.target

[Service]
Type=simple
User=streetsense
WorkingDirectory=/opt/streetsense
Environment=PORT=8000
Environment=COOKIE_SECURE=1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# Basic hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
